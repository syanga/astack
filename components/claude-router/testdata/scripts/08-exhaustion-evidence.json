{
  "name": "exhaustion-evidence",
  "description": "A 429 whose only quota evidence predates the attempt is generic throttling: the request retries on its account, up to three attempts, and the assignment stays. The same 429 with a rejected window observed during the attempt is confirmed exhaustion and migrates. A rejection without a reported reset waits inexactly until the five-minute recheck.",
  "start": "2026-10-05T09:00:00Z",
  "accounts": [{"id": "acct-a", "capacity": 1}, {"id": "acct-b", "capacity": 1}],
  "steps": [
    {"at_minutes": 0, "overage": {"state": "disabled"}},
    {"at_minutes": 0, "route": {"conversation": "conv", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 10, "report": {"account": "acct-a", "model": "claude-sonnet-4-5", "class": "exhausted", "evidence_age_minutes": 10, "windows": [{"kind": "five_hour", "rejected": true, "utilization": 1, "reset_in_minutes": 60}]}},
    {"at_minutes": 10, "route": {"conversation": "conv", "model": "claude-sonnet-4-5", "attempt": 2, "last_failure": "throttle"}, "expect": {"any": {"kind": "retry", "account": "acct-a"}}},
    {"at_minutes": 10, "route": {"conversation": "conv", "model": "claude-sonnet-4-5", "attempt": 4, "last_failure": "throttle"}, "expect": {"any": {"kind": "fail", "account": "acct-a", "bound_to": "acct-a"}}},
    {"at_minutes": 11, "report": {"account": "acct-a", "model": "claude-sonnet-4-5", "class": "exhausted", "windows": [{"kind": "five_hour", "rejected": true, "utilization": 1, "reset_in_minutes": 60}]}},
    {"at_minutes": 11, "route": {"conversation": "conv", "model": "claude-sonnet-4-5", "attempt": 2, "last_failure": "exhausted"}, "expect": {"any": {"kind": "migrate", "from": "acct-a", "account": "acct-b"}}},
    {"at_minutes": 12, "report": {"account": "acct-b", "model": "claude-sonnet-4-5", "class": "exhausted", "windows": [{"kind": "unspecified", "rejected": true}]}},
    {"at_minutes": 12, "route": {"conversation": "conv", "model": "claude-sonnet-4-5", "attempt": 2, "last_failure": "exhausted"}, "expect": {"any": {"kind": "wait", "until_minutes": 17, "reset_known": false, "bound_to": "acct-b"}}},
    {"at_minutes": 17, "route": {"conversation": "conv", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-b"}}}
  ]
}
