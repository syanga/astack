{
  "name": "subagent-inheritance",
  "description": "Subagents send the parent's session id. A child and a nested child dispatch on the parent's account even though acct-b is idle and near reset, which independent placement would choose. After the parent's account is exhausted and the conversation migrates, later child requests dispatch on the new account instead of being placed.",
  "start": "2026-10-05T09:00:00Z",
  "accounts": [{"id": "acct-a", "capacity": 1}, {"id": "acct-b", "capacity": 1}],
  "steps": [
    {"at_minutes": 0, "overage": {"state": "disabled"}},
    {"at_minutes": 0, "route": {"conversation": "session-1", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "observe": {"account": "acct-b", "windows": [{"kind": "five_hour", "utilization": 0, "reset_in_minutes": 10}]}},
    {"at_minutes": 1, "route": {"conversation": "session-1", "agent": "agent-1", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-a"}}},
    {"at_minutes": 1, "route": {"conversation": "session-1", "agent": "agent-2", "parent_agent": "agent-1", "model": "claude-haiku-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-a"}}},
    {"at_minutes": 2, "report": {"account": "acct-a", "model": "claude-sonnet-4-5", "class": "exhausted", "windows": [{"kind": "five_hour", "rejected": true, "utilization": 1, "reset_in_minutes": 120}]}},
    {"at_minutes": 2, "route": {"conversation": "session-1", "model": "claude-sonnet-4-5", "attempt": 2, "last_failure": "exhausted"}, "expect": {"any": {"kind": "migrate", "from": "acct-a", "account": "acct-b", "reason": "exhausted"}}},
    {"at_minutes": 3, "route": {"conversation": "session-1", "agent": "agent-1", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-b"}}},
    {"at_minutes": 3, "route": {"conversation": "session-1", "agent": "agent-2", "parent_agent": "agent-1", "model": "claude-haiku-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-b"}}}
  ]
}
