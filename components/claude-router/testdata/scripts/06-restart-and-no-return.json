{
  "name": "restart-and-no-return",
  "description": "A conversation keeps acct-a across a restart, three idle hours, and a model change. Confirmed exhaustion moves it to acct-b. After another restart acct-a recovers with fresh, unused allowance: a new conversation goes to acct-a, but the migrated conversation stays on acct-b.",
  "start": "2026-10-05T09:00:00Z",
  "accounts": [{"id": "acct-a", "capacity": 1}, {"id": "acct-b", "capacity": 1}],
  "steps": [
    {"at_minutes": 0, "overage": {"state": "disabled"}},
    {"at_minutes": 0, "route": {"conversation": "conv", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "restart": true},
    {"at_minutes": 180, "overage": {"state": "disabled"}},
    {"at_minutes": 180, "observe": {"account": "acct-b", "windows": [{"kind": "five_hour", "utilization": 0, "reset_in_minutes": 10}]}},
    {"at_minutes": 180, "route": {"conversation": "conv", "model": "claude-opus-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-a"}}},
    {"at_minutes": 181, "report": {"account": "acct-a", "model": "claude-opus-4-5", "class": "exhausted", "windows": [{"kind": "five_hour", "rejected": true, "utilization": 1, "reset_in_minutes": 60}]}},
    {"at_minutes": 181, "route": {"conversation": "conv", "model": "claude-opus-4-5", "attempt": 2, "last_failure": "exhausted"}, "expect": {"any": {"kind": "migrate", "from": "acct-a", "account": "acct-b"}}},
    {"at_minutes": 181, "restart": true},
    {"at_minutes": 300, "overage": {"state": "disabled"}},
    {"at_minutes": 300, "observe": {"account": "acct-a", "windows": [{"kind": "five_hour", "utilization": 0, "reset_in_minutes": 20}]}},
    {"at_minutes": 300, "route": {"conversation": "conv", "model": "claude-opus-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-b", "bound_to": "acct-b"}}},
    {"at_minutes": 300, "route": {"conversation": "fresh", "model": "claude-opus-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}}
  ]
}
