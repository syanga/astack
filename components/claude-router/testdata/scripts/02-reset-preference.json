{
  "name": "reset-preference",
  "description": "Two capacity-1 accounts each hold one active conversation. A fresh observation shows acct-a at 10% of a five-hour window that resets in 30 minutes (slack 0.9-0.1 = 0.8) and acct-b on pace (slack 0). With the default bias 8, a's weight is 1+8*0.8 = 7.4, so reset-aware sends all six new conversations to a ((n+1)/7.4 < 2 for n <= 6). Capacity-only alternates a b a b a b. The existing conversation on b stays on b under both rules.",
  "start": "2026-10-05T09:00:00Z",
  "accounts": [{"id": "acct-a", "capacity": 1}, {"id": "acct-b", "capacity": 1}],
  "steps": [
    {"at_minutes": -10, "overage": {"state": "disabled"}},
    {"at_minutes": -10, "route": {"conversation": "old-1", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": -10, "route": {"conversation": "old-2", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-b"}}},
    {"at_minutes": 0, "observe": {"account": "acct-a", "windows": [
      {"kind": "five_hour", "utilization": 0.1, "reset_in_minutes": 30},
      {"kind": "weekly", "utilization": 0.3, "reset_in_minutes": 5040}]}},
    {"at_minutes": 0, "observe": {"account": "acct-b", "windows": [
      {"kind": "five_hour", "utilization": 0.5, "reset_in_minutes": 150},
      {"kind": "weekly", "utilization": 0.5, "reset_in_minutes": 5040}]}},
    {"at_minutes": 0, "route": {"conversation": "new-0", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {
      "capacity_only": {"kind": "place", "account": "acct-a", "reason": "capacity"},
      "reset_aware": {"kind": "place", "account": "acct-a", "reason": "capacity"}}},
    {"at_minutes": 0, "route": {"conversation": "new-1", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {
      "capacity_only": {"kind": "place", "account": "acct-b", "reason": "capacity"},
      "reset_aware": {"kind": "place", "account": "acct-a", "reason": "reset_preference"}}},
    {"at_minutes": 0, "route": {"conversation": "new-2", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {
      "capacity_only": {"kind": "place", "account": "acct-a"},
      "reset_aware": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "route": {"conversation": "new-3", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {
      "capacity_only": {"kind": "place", "account": "acct-b"},
      "reset_aware": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "route": {"conversation": "new-4", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {
      "capacity_only": {"kind": "place", "account": "acct-a"},
      "reset_aware": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "route": {"conversation": "new-5", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {
      "capacity_only": {"kind": "place", "account": "acct-b"},
      "reset_aware": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "route": {"conversation": "old-2", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-b"}}}
  ]
}
