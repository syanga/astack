{
  "name": "stale-observations",
  "description": "acct-a's near-reset observation is 30 minutes old, past the 15-minute freshness default, so reset-aware placement falls back to capacity weights and matches capacity-only: a b a b. acct-c's weekly rejection is three hours old but still excludes it until its reset; after the reset at minute 1440 it takes new work again.",
  "start": "2026-10-05T09:00:00Z",
  "accounts": [{"id": "acct-a", "capacity": 1}, {"id": "acct-b", "capacity": 1}, {"id": "acct-c", "capacity": 1}],
  "steps": [
    {"at_minutes": 0, "overage": {"state": "disabled"}},
    {"at_minutes": 0, "observe": {"account": "acct-a", "age_minutes": 30, "windows": [{"kind": "five_hour", "utilization": 0.1, "reset_in_minutes": 30}]}},
    {"at_minutes": 0, "observe": {"account": "acct-c", "age_minutes": 180, "windows": [{"kind": "weekly", "rejected": true, "utilization": 1, "reset_in_minutes": 1440}]}},
    {"at_minutes": 0, "route": {"conversation": "n0", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a", "reason": "capacity"}}},
    {"at_minutes": 0, "route": {"conversation": "n1", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-b", "reason": "capacity"}}},
    {"at_minutes": 0, "route": {"conversation": "n2", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "route": {"conversation": "n3", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-b"}}},
    {"at_minutes": 1440, "overage": {"state": "disabled"}},
    {"at_minutes": 1440, "route": {"conversation": "n4", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 1440, "route": {"conversation": "n5", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-b"}}},
    {"at_minutes": 1440, "route": {"conversation": "n6", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-c"}}}
  ]
}
