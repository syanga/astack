{
  "name": "auth-and-included-only",
  "description": "With no account verified, a new conversation is refused and a recheck requested. An auth failure on acct-a excludes it from new placement. Its conversation that has served a response gets reauth and keeps acct-a; its conversation that never served moves to acct-b. Paid use on acct-b, with acct-a still logged out, refuses its conversation without moving it. After relogin, the same paid use moves it to acct-a. A stale overage check on acct-a then refuses dispatch with a recheck and does not move it, even though acct-b is verified.",
  "start": "2026-10-05T09:00:00Z",
  "accounts": [{"id": "acct-a", "capacity": 1}, {"id": "acct-b", "capacity": 1}],
  "steps": [
    {"at_minutes": 0, "route": {"conversation": "unverified", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "refuse", "reason": "no_included_only_account", "recheck_overage": true}}},
    {"at_minutes": 0, "overage": {"state": "disabled"}},
    {"at_minutes": 0, "route": {"conversation": "existing", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "route": {"conversation": "balance", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-b"}}},
    {"at_minutes": 0, "route": {"conversation": "fresh", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 0, "served": {"conversation": "existing", "account": "acct-a"}},
    {"at_minutes": 1, "report": {"account": "acct-a", "model": "claude-sonnet-4-5", "class": "auth"}},
    {"at_minutes": 1, "route": {"conversation": "newcomer", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-b"}}},
    {"at_minutes": 1, "route": {"conversation": "existing", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "reauth", "account": "acct-a", "reason": "needs_login", "bound_to": "acct-a"}}},
    {"at_minutes": 1, "route": {"conversation": "fresh", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "migrate", "from": "acct-a", "account": "acct-b", "reason": "never_served_relogin"}}},
    {"at_minutes": 2, "move": {"conversation": "existing", "to": "acct-b"}},
    {"at_minutes": 2, "route": {"conversation": "existing", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "dispatch", "account": "acct-b"}}},
    {"at_minutes": 3, "overage": {"account": "acct-b", "state": "paid_use"}},
    {"at_minutes": 3, "route": {"conversation": "existing", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "refuse", "account": "acct-b", "reason": "paid_use_observed", "bound_to": "acct-b"}}},
    {"at_minutes": 4, "relogin": "acct-a"},
    {"at_minutes": 4, "route": {"conversation": "existing", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "migrate", "from": "acct-b", "account": "acct-a", "reason": "overage_observed"}}},
    {"at_minutes": 4, "route": {"conversation": "after-relogin", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "place", "account": "acct-a"}}},
    {"at_minutes": 61, "overage": {"account": "acct-b", "state": "disabled"}},
    {"at_minutes": 61, "route": {"conversation": "existing", "model": "claude-sonnet-4-5", "attempt": 1}, "expect": {"any": {"kind": "refuse", "account": "acct-a", "reason": "overage_stale", "recheck_overage": true, "bound_to": "acct-a"}}}
  ]
}
